# rcmd device inventory (示例模板)
# 复制为 devices.yaml 并填入真实信息：cp devices.yaml.example devices.yaml
# devices.yaml 已被 .gitignore 忽略，不会提交真实密码。
#
# Each device is a named remote shell target reached over telnet, ssh, serial or adb.
# rcmd keeps one persistent shell per device so cd/env/state survive across calls.

board:
  transport: telnet
  host: 192.168.1.50
  port: 23
  username: root
  password: CHANGE_ME
  login_prompt: "login:"            # regex, awaited before sending username
  password_prompt: "[Pp]assword:"   # regex, awaited before sending password
  shell_prompt: "[#$] $"            # regex, marks the interactive shell is ready

server:
  transport: ssh
  host: 10.0.0.1
  port: 22
  username: youruser
  password: CHANGE_ME               # ssh 可用密码或留空走 key 认证
  shell_prompt: "[#$] $"

# Serial console (e.g. UART debug port on embedded boards)
# Requires: pip install pyserial
serial_board:
  transport: serial
  port: COM3                        # Windows: COM3 / Linux: /dev/ttyUSB0
  baud: 115200                      # default 115200

# Serial console reached over a serial-bridge WebSocket gateway.
# The physical serial port lives on ANOTHER host running serial-bridge
# (https://github.com/Yo-gurts/serial-bridge). Use this when rcmd runs on a
# server but the device's UART is attached to a Windows/other machine.
# Requires: pip install websocket-client
serial_bridge_board:
  transport: serial_bridge
  url: ws://192.168.1.10:8000/ws    # the gateway's WebSocket endpoint
  token: CHANGE_ME                  # gateway --token (omit/empty if gateway is token-free)
  port: COM7                        # the COM port ON THE GATEWAY host
  baud: 115200                      # default 115200

# Prompt-based shell with NO POSIX $? (RT-Thread msh / FinSH, U-Boot, …).
# Boundary = the shell prompt reappearing (regex, configurable); exit code is a
# heuristic (127 on error_pattern match, else 0). `prompt` = local serial;
# `prompt_bridge` = over a serial-bridge gateway (needs websocket-client).
msh_board:
  transport: prompt_bridge          # or `prompt` for a local serial port
  url: ws://192.168.1.10:8000/ws    # gateway WebSocket (prompt_bridge only)
  token: CHANGE_ME                  # gateway --token (omit if token-free)
  port: COM9                        # COM port on the gateway (prompt: local path)
  baud: 115200
  prompt: "msh [^\r\n>]*>"          # default; matches "msh />", "msh /mnt>" …
                                    #   U-Boot example: prompt: "=> "
  error_pattern: "command not found"  # output matching this → exit code 127

# Android device / board with adbd (embedded Linux with adb daemon)
# Requires: adb in PATH (Android platform-tools)
adb_board:
  transport: adb
  serial: 0123456789                # adb device serial (adb devices -l);
                                    # omit to use the single connected device
